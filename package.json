{
  "name": "cifras-scroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "vue-tsc --noEmit && wxt build",
    "zip": "vue-tsc --noEmit && wxt zip",
    "test": "vitest run",
    "check": "pnpm test && pnpm build",
    "release": "pnpm test && pnpm zip && node scripts/verify-release.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
